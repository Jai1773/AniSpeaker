{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ─── CORS ───────────────────────────────────────────────────────────────────
  // Override on Render via env vars:
  //   Cors__AllowedOrigins__0=https://yourapp.pages.dev
  //   Cors__AllowedOrigins__1=https://yourdomain.com
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://anispeaker.pages.dev"
    ]
  },

  // ─── Connection string ───────────────────────────────────────────────────────
  // Leave EMPTY here. Set ConnectionStrings__Default in Render environment variables.
  // Paste your Neon connection string exactly as shown in the Neon console, e.g.:
  //   postgresql://neondb_owner:<password>@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
  "ConnectionStrings": {
    "Default": ""
  },

  // ─── JWT ────────────────────────────────────────────────────────────────────
  // NEVER commit a real secret here. Override on Render:
  //   Jwt__Secret=<your-64-char-random-string>
  "Jwt": {
    "Issuer": "AniSpeaker",
    "Audience": "AniSpeaker.Web",
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_BEFORE_DEPLOYMENT",
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_BEFORE_DEPLOYMENT_MIN_32_CHARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },

  // ─── Cloudflare R2 storage ──────────────────────────────────────────────────
  // Override on Render:
  //   R2__AccountId, R2__AccessKey, R2__SecretKey, R2__BucketName, R2__PublicBaseUrl
  "R2": {
    "AccountId": "",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "",
    "PublicBaseUrl": ""
  },

  // ─── Migrations ─────────────────────────────────────────────────────────────
  // Set Database__ApplyMigrations=true in Render ONLY for the first deploy.
  // Remove or set to false after migrations succeed.
  "Database": {
    "ApplyMigrations": true
  },
  "AllowedHosts": "*"
    "ApplyMigrations": false
  }
}
